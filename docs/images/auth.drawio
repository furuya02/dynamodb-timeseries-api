" y="574" width="1100" height="20" as="geometry"/></mxCell><mxCell id="b24" value="Grafana&lt;br&gt;(header x-api-key)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#F46800;fontColor=#232F3E;fontSize=12;dashed=0;fontStyle=1;align=center;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="616" width="240" height="64" as="geometry"/></mxCell><mxCell id="i25" value="REST API&lt;br&gt;+ usage plan" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1"><mxGeometry x="560" y="620" width="56" height="56" as="geometry"/></mxCell><mxCell id="e26" value="API key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;strokeColor=#1565C0;strokeWidth=2;fontColor=#1565C0;fontSize=11;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" source="b24" target="i25" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>