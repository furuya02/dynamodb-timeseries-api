  "tags": ["dynamodb-timeseries-api", "dynamodb"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "key",
        "label": "Room",
        "type": "query",
        "datasource": {
          "type": "yesoreyeram-infinity-datasource",
          "uid": "tsapi"
        },
        "query": {
          "queryType": "infinity",
          "refId": "variable",
          "infinityQuery": {
            "refId": "variable",
            "datasource": {
              "type": "yesoreyeram-infinity-datasource",
              "uid": "tsapi"
            },
            "type": "json",
            "source": "url",
            "parser": "backend",
            "url": "keys",
            "url_options": {
              "method": "GET",
              "data": "",
              "params": [
                {
                  "key": "dataset",
                  "value": "room_temp"
                }
              ]
            },
            "root_selector": "",
            "columns": [
              {
                "selector": "key",
                "text": "key",
                "type": "string"
              }
            ],
            "filters": [],
            "format": "table"
          }
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        },
        "sort": 1,
        "definition": "GET keys?dataset=room_temp"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Temperature (average per interval)",
      "type": "timeseries",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "tsapi"
      },
      "description": "The API aggregates with interval=${__interval_ms}, so widening the time range does not add too many points",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "tsapi"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "url": "query",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "dataset",
                "value": "room_temp"
              },
              {
                "key": "key",
                "value": "${key:csv}"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              },
              {
                "key": "interval",
                "value": "${__interval_ms}"
              },
              {
                "key": "agg",
